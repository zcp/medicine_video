# 应用配置
API_V1_STR=/api/v1
PROJECT_NAME=LiveStream SaaS

POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<必填：openssl rand -hex 32 生成，勿与生产一致>
POSTGRES_DB=live_core_test
POSTGRES_PORT=5432

# live_core_service 的数据库
LIVE_CORE_DB=live_core_test

# media_download_service 的数据库
MEDIA_DOWNLOAD_DB=media_download_test

USER_DB=users_service_test

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

DATABASE_URL=postgresql://postgres:<CHANGE_ME>@postgres:5432/live_core_test

DOWNLOAD_DIR=/media_download/storage

REDIS_URL=redis://redis:6379/0

# 内部服务间调用 Token（live_core 与 users 必须相同）
INTERNAL_SERVICE_TOKEN=<必填：openssl rand -hex 32 生成，勿与生产一致>

# 服务间调用地址
USER_SERVICE_URL=http://<你的域名>/
LIVE_CORE_SERVICE_URL=http://<你的域名>/

# 内容安全开关
CONTENT_SAFETY_ENABLED=true

# 其他配置
DEBUG=No
SECRET_KEY=<必填：openssl rand -hex 32 生成，勿与生产一致>

JWT_SECRET_KEY=<必填：openssl rand -hex 32 生成，勿与生产一致>

USER_POOL_SECRET=<必填：openssl rand -hex 32 生成，勿与生产一致>
APP_HOST=https://<你的域名>/
REDIRECT_URL=https://<你的域名>/console/get-started/<你的应用ID>
# ===== 应用 Client ID =====
# 用于 verify_id_token 时的 audience 校验
VITE_CLIENT_ID=<必填：openssl rand -hex 32 生成，勿与生产一致>
ISSUER=https://<你的域名>/oidc
USER_POOL_ID=689d1fd6692ac11be54200ac

#系统前端配置信息
# API 地址 - 使用容器内部网络地址
VITE_BASE_API_URL=http://<你的域名>/api/v1
VITE_AUTH_API_URL=http://<你的域名>/
VITE_LOGIN_URL=http://<你的域名>/pages/auth/login

# 前端地址 - 使用外部访问地址
# 正确写法
VITE_FRONTEND_USER_URL=https://<你的域名>/
VITE_FRONTEND_DOWNLOAD_URL=https://<你的域名>/
VITE_FRONTEND_LIVE_URL=https://<你的域名>/


# Authing 配置
VITE_AUTHING_HOST=uni-app-multiplatform.authing.cn
VITE_AUTHING_CLIENT_ID=<必填：openssl rand -hex 32 生成，勿与生产一致>
VITE_AUTHING_USER_POOL_ID=689d1fd6692ac11be54200ac
VITE_AUTHING_REDIRECT_URI_H5=http://localhost:5173/pages/auth/callback

# 其他配置
VITE_APP_TITLE=直播SaaS平台
VITE_API_TIMEOUT=30000
VITE_CALLBACK_PATH=/pages/auth/callback

# 号码认证提供商（仅支持 mock 或空；代码未实现 dcloud 取号，云函数一键登录走 HMAC 验签不依赖此项）
CARRIER_AUTH_PROVIDER=mock

# DCloud 云函数 API 密钥（方案B：HMAC 签名验证，云函数和后端各存一份）
DCLOUD_API_KEY=<必填：openssl rand -hex 32 生成，勿与生产一致>

# 短信服务提供商（开发环境用 mock，生产用 aliyun）
# SMS_PROVIDER=aliyun

# 阿里云短信认证配置（SMS_PROVIDER=aliyun 时必填，号码认证服务 PNVS，免企业资质）
# ALIYUN_ACCESS_KEY_ID=your_access_key_id
# ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
# ALIYUN_SMS_SIGN_NAME=系统预置或申请的短信签名
# ALIYUN_SMS_TEMPLATE_CODE=短信认证模板编码

# CORS 允许的来源（开发环境用 *，生产必须指定具体域名）
CORS_ORIGINS=*

ROOM_MEDIA_ROOT_PATH=/media_upload/storage
# 封面上传配置
UPLOAD_MAX_SIZE=10485760                   # 最大文件大小 10MB (字节)， 和vzan一样
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif # 允许的文件扩展名（逗号分隔）

# ===== 视频回放配置 =====
# 回放地址Base URL（可以是CDN域名或本地路径）
#PLAYBACK_BASE_URL=https://your-cdn-domain.com  # 生产环境使用CDN
PLAYBACK_BASE_URL=http://localhost:8000       # 开发环境使用本地

# ===== 说明 =====
# 1) 本文件为模板：复制为 .env.docker 后填写所有 <必填>/<CHANGE_ME>/<你的域名> 项（.env.docker 已被 .gitignore 排除，不会入库）
# 2) 数据库三库由 compose-db.yml + init-db.sh 自动创建：live_core_test / media_download_test / users_service_test
# 3) 容器内跑 pytest 的口令由本文件 POSTGRES_PASSWORD 注入；本机直跑 pytest 需手动 export 同名变量