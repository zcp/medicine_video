    "mp-weixin" : {
        "appid" : "wxfa6bac37fec625a8",
        "setting" : {
            "urlCheck" : false
        },
        "usingComponents" : true
    },
    "h5" : {
        "template" : "index.html",
        "router" : {
            "mode" : "hash"
        },
        "title" : "LiveSaaS"
    },
    "vueVersion" : "3",
    "locale" : "auto",
