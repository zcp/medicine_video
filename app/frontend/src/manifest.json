{
    "name" : "LiveSaaS",
    "appid" : "__UNI__1A0301F",
    "description" : "直播SaaS平台移动端应用",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    "app-plus" : {
