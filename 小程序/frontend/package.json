{
  "name": "live-saas-wechat-mp",
  "version": "1.0.0",
  "description": "直播SaaS平台微信小程序前端",
  "private": true,
  "scripts": {
    "dev:h5": "uni -p h5",
    "dev:mp-weixin": "cross-env NODE_ENV=development uni -p mp-weixin",
    "inject:console": "node scripts/inject-console-patch.js",
    "inject:console:watch": "node scripts/inject-console-patch.js --watch",
    "dev:debug": "cross-env NODE_ENV=development UNI_MP_DEBUG=true uni -p mp-weixin --debug",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "node -e \"require('fs').rmSync('dist/build/mp-weixin',{recursive:true,force:true})\" && cross-env NODE_ENV=production uni build -p mp-weixin && node scripts/inject-console-patch.js",
    "build:mp-weixin:dev": "node -e \"require('fs').rmSync('dist/build/mp-weixin',{recursive:true,force:true})\" && cross-env NODE_ENV=development uni build -p mp-weixin && node scripts/inject-console-patch.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "format:wxml": "node scripts/format-wxml.js",
    "check:types": "node scripts/check-types.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@dcloudio/uni-app": "^3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-app-harmony": "3.0.0-alpha-4070620250731001",
