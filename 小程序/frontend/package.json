    "@dcloudio/uni-h5": "^3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-mp-baidu": "3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-mp-harmony": "3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-mp-jd": "3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-mp-kuaishou": "3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-mp-lark": "3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-mp-qq": "3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-mp-toutiao": "3.0.0-alpha-4070620250731001",
    "@dcloudio/uni-mp-weixin": "^3.0.0-alpha-4070620250731001",
