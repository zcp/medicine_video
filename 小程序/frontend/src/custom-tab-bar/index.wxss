@import "../static/iconfont/iconfont.wxss";

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-index-tabbar, 200);
  min-height: 100rpx;
  box-sizing: border-box;
}

.tabbar__card {
  min-height: 100rpx;
  background: var(--color-surface, #ffffff);
  border-top: 2rpx solid var(--color-border-light, rgba(0, 0, 0, 0.06));
  border-top-left-radius: var(--border-radius-lg, 20rpx);
  border-top-right-radius: var(--border-radius-lg, 20rpx);
  box-shadow: var(--shadow-tabbar, 0 -2rpx 12rpx rgba(0, 0, 0, .08));
  box-sizing: border-box;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar__row {
  height: 100rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab {
  flex: 1;
  min-width: 0;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  box-sizing: border-box;
  color: var(--color-text-secondary, #909399);
  transition: var(--transition-base, 180ms ease);
}

.tabbar__spacer {
  flex: 0 0 168rpx;
  width: 168rpx;
  height: 100rpx;
  box-sizing: border-box;
}

.tab:active {
  opacity: 0.72;
}

.tab.is-active {
  color: var(--color-primary, #0f766e);
}

.tab__icon {
  font-size: 44rpx;
  line-height: 1;
  margin-bottom: 4rpx;
  color: inherit;
}

.tab__text {
  font-size: 20rpx;
  line-height: 1;
  color: inherit;
}

.add {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  top: 0;
  width: 168rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add__btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--border-radius-full, 9999rpx);
  background: var(--color-primary, #0f766e);
  border: 0;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition-base, 180ms ease);
}

.add__btn:active {
  background: var(--color-primary-dark, #0a5c56);
}

.add__plus {
  font-size: 60rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--color-text-inverse, #ffffff);
  transform: translateY(-1rpx);
}
