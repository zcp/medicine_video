# 应用配置模板 —— 复制为仓库根目录 .env.docker 后按需填写
#   copy .env.docker.example .env.docker   (Windows)
#   cp .env.docker.example .env.docker     (Linux/macOS)
#
# .env.docker 含密钥，已加入 .gitignore，请勿提交仓库。

# 应用配置
API_V1_STR=/api/v1
PROJECT_NAME=LiveStream SaaS

POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=live_core_test
POSTGRES_PORT=5432

LIVE_CORE_DB=live_core_test
MEDIA_DOWNLOAD_DB=media_download_test
USER_DB=users_service_test

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/live_core_test
DOWNLOAD_DIR=/media_download/storage
REDIS_URL=redis://redis:6379/0

DEBUG=No
SECRET_KEY=change-me-secret-key
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars!!!!

# Authing（按需）
USER_POOL_SECRET=
APP_HOST=
REDIRECT_URL=
VITE_CLIENT_ID=
ISSUER=
USER_POOL_ID=

VITE_BASE_API_URL=http://live_core_service:8000/api/v1
VITE_AUTH_API_URL=http://user_service:8002/
VITE_LOGIN_URL=http://user_service:8002/pages/auth/login
VITE_FRONTEND_USER_URL=http://localhost:5173
VITE_FRONTEND_DOWNLOAD_URL=http://localhost:3000
VITE_FRONTEND_LIVE_URL=http://localhost:8080
VITE_AUTHING_HOST=
VITE_AUTHING_CLIENT_ID=
VITE_AUTHING_USER_POOL_ID=
VITE_AUTHING_REDIRECT_URI_H5=http://localhost:5173/pages/auth/callback
VITE_APP_TITLE=直播SaaS平台
VITE_API_TIMEOUT=30000
VITE_CALLBACK_PATH=/pages/auth/callback

ROOM_MEDIA_ROOT_PATH=/media_upload/storage
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif
PLAYBACK_BASE_URL=http://localhost:8000

POLITICAL_TEXT_PROVIDER=placeholder
POLITICAL_TEXT_PLACEHOLDER_REJECT=false
POLITICAL_TEXT_API_KEY=

IMAGE_MODERATION_PROVIDER=placeholder
IMAGE_MODERATION_API_KEY=
IMAGE_MODERATION_API_SECRET=

USER_SERVICE_URL=http://user_service:8002
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me
LIVE_CORE_SERVICE_URL=http://live_core_service:8000
LIVE_CORE_CLEANUP_TIMEOUT_SECONDS=5
ADMIN_STREAM_BYPASS=true

# ===== V3 手机号与运营商登录 =====
ENVIRONMENT=development
SMS_PROVIDER=mock
CARRIER_AUTH_PROVIDER=mock
DCLOUD_API_KEY=dev-dcloud-hmac-key-change-me

# ===== V4 微信小程序一键授权登录 =====
WECHAT_AUTH_PROVIDER=mock
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_CODE=

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ===== V5 邮箱验证码登录 =====
# 开发无 SMTP：EMAIL_PROVIDER=mock（OTP 仍写 Redis，可 docker exec redis 查看）
# 真发邮件：EMAIL_PROVIDER=smtp 并填写下方授权码，然后：
#   docker compose -f docker-compose.yml -f docker-compose.windows.yml up -d --force-recreate user_service
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
